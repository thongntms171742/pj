# Build Your Christmas — Backend environment EXAMPLE
# Copy file này thành `backend/.env` và điền giá trị thật.
# `backend/.env` đã được `.gitignore` chặn — KHÔNG BAO GIỜ commit thật secret.

# ── MongoDB Atlas ───────────────────────────────────────────
# 1. Tạo cluster free tại https://cloud.mongodb.com
# 2. Network Access → Allow Access from Anywhere (0.0.0.0/0) cho dev
#    (production nên restrict theo IP của Render)
# 3. Database Access → tạo user + password
# 4. Database → Deployments → Connect → Drivers → copy URI
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/christmas?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ─────────────────────────────────────────────────────
# Production: dùng `openssl rand -base64 48` để sinh giá trị random.
# Trên Render: để `render.yaml` generateValue=true cho JWT_SECRET.
JWT_SECRET=replace-me-with-a-random-48-char-base64-string
JWT_EXPIRES_IN=7d

# ── Server ──────────────────────────────────────────────────
PORT=4000

# ── Seed (chạy `npm run seed -- --confirm-seed` lần đầu) ───
# Dùng để tạo admin + buyer demo + 3 trees + 6 styles + 25 accessories.
# Production: dùng password mạnh, KHÔNG để giá trị mặc định.
SEED_ADMIN_PASSWORD=Admin@BYC2026
SEED_BUYER_PASSWORD=Buyer@BYC2026

# ── Business config (optional) ─────────────────────────────
# Mặc định "79" = TP.HCM. Chỉ override khi mở rộng vùng phục vụ.
# SERVICE_PROVINCE_ID=79

# ── Frontend URL (cho CORS — Express + Socket.io) ─────────
# Production FE: https://rungtrongpho.vercel.app
# Dev FE: http://localhost:3000 / http://localhost:5173
# Nếu không set, code sẽ dùng allowlist cứng (rungtrongpho.vercel.app + vercel.app preview + localhost)
# FRONTEND_URL=https://rungtrongpho.vercel.app

# ── Cloudinary Media Storage ───────────────────────────────
# Tạo tài khoản miễn phí tại https://cloudinary.com
# Cách 1 (Khuyên dùng): Dùng URL tổng hợp trong Dashboard
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Cách 2: Điền từng trường rời rạc
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=buildyourchristmas

# Bật 'true' trên Production (Render) để từ chối upload nếu quên cấu hình Cloudinary
REQUIRE_CLOUDINARY=false

# ── Cổng thanh toán SePay (VietQR & Webhook) ────────────────
# 1. Đăng ký & liên kết tài khoản ngân hàng tại https://my.sepay.vn
# 2. Tạo API Key tại mục Cấu hình API / Webhook
# 3. Webhook URL cấu hình trên SePay: https://christmas-8ca4.onrender.com/api/payments/sepay/webhook
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_BANK_ACCOUNT=VQRQAMTPI1482
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_HOLDER=NGUYEN TANG MINH THONG
SEPAY_STORE_NAME=RUNG TRONG PHO
# Template QR: 'compact', 'qronly', hoặc 'standee' (mặc định: compact)
SEPAY_QR_TEMPLATE=compact
SEPAY_QR_SHOW_INFO=true
SEPAY_QR_FULL_ACC=true

# ════════════════════════════════════════════════════════════════════════════
# AI CHAT (Hybrid AI & Human Support — TDD v1.0)
# ════════════════════════════════════════════════════════════════════════════
# AI dùng Gemini. KHÔNG có API key ⇒ AI tự tắt (graceful degradation):
#   - Conversation mới khởi tạo `supportMode = "waiting_admin"`.
#   - Chat vẫn hoạt động bình thường, chỉ không có AI trả lời.
#
# 1. Tạo API key tại https://aistudio.google.com/apikey
# 2. Điền vào GEMINI_API_KEY
# 3. Bật FEATURE_AI_CHAT=true

GEMINI_API_KEY=
# Model chat (mặc định gemini-2.5-flash — nhanh + rẻ).
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Model embedding (Phase 4 — semantic search trong kho tri thức).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Timeout mỗi lần gọi Gemini (ms) + số lần retry.
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_MS=400

# ── Feature flags ───────────────────────────────────────────
# Bật AI trả lời khách hàng.
FEATURE_AI_CHAT=true
# Bật AI tự chuyển nhân viên khi không xử lý được.
FEATURE_AI_HANDOFF=true
# Bật AI Copilot cho admin (tóm tắt / gợi ý trả lời / ghi chú nội bộ).
FEATURE_AI_COPILOT=false
# Bật kho tri thức (tool `policySearch` cho AI + API tra chính sách).
FEATURE_KNOWLEDGE_BASE=true

# ── Giới hạn AI ─────────────────────────────────────────────
# Số tin nhắn gần nhất đưa vào context cho Gemini.
AI_MAX_HISTORY_MESSAGES=20
# Token tối đa cho 1 response.
AI_MAX_OUTPUT_TOKENS=1024
# Số function call tối đa trong 1 lượt xử lý.
AI_MAX_TOOL_CALLS=3
# Số lượt AI mà 1 user được gọi trong 1 ngày.
AI_DAILY_USER_LIMIT=100
# Ngưỡng confidence dưới đây ⇒ AI đánh dấu "cần người duyệt".
AI_LOW_CONFIDENCE_THRESHOLD=0.5
# Số lần AI thất bại liên tiếp ⇒ auto chuyển nhân viên.
AI_MAX_FAILED_ATTEMPTS=2
# Version system prompt (để đo tác động khi đổi prompt).
SYSTEM_PROMPT_VERSION=v1

# ── Handoff ─────────────────────────────────────────────────
# Số lần escalate tối đa cho 1 user trong cửa sổ thời gian.
HANDOFF_RATE_LIMIT=3
HANDOFF_RATE_LIMIT_WINDOW_MS=600000
# Số lần AI thất bại liên tiếp trước khi tự chuyển Admin.
HANDOFF_AUTO_ESCALATE_ATTEMPTS=2

# ── Chat config ─────────────────────────────────────────────
CHAT_PAGE_SIZE_DEFAULT=20
CHAT_PAGE_SIZE_MAX=100
CHAT_MESSAGE_MAX_LENGTH=5000
CHAT_ATTACHMENT_MAX=5
CHAT_ATTACHMENT_MAX_BYTES=10485760
CHAT_MAX_MESSAGES_PER_PAGE=50
# Số tin nhắn/giây tối đa qua socket (chống spam).
CHAT_SOCKET_RATE_LIMIT=10
CHAT_SOCKET_RATE_LIMIT_WINDOW_MS=1000
# Cửa sổ được mở lại conversation đã đóng (ms) — mặc định 24h.
CHAT_REOPEN_WINDOW_MS=86400000

# ── Chính sách giao hàng (cho AI tool `shippingInfo`) ───────
# Nguồn sự thật cho AI — AI KHÔNG tự bịa phí ship / thời gian giao.
CHAT_SHIPPING_FEE=20000
CHAT_PRODUCTION_DAYS=2
CHAT_DELIVERY_DAYS=3
CHAT_COD_SUPPORTED=true
CHAT_COD_FEE=0
# Danh sách tỉnh/thành giao được, phân tách bởi dấu phẩy.
# Rỗng ⇒ AI sẽ chuyển nhân viên khi khách hỏi về vùng giao.
CHAT_SUPPORTED_PROVINCES=

