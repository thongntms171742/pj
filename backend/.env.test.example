# Test environment template
# Copy this file to `.env.test` and fill in real values.
# `.env.test` is gitignored and should NEVER be committed with real secrets.

# Dedicated MongoDB database for tests (NEVER use the production thriftit database).
# Recommended: same Atlas cluster as production but with database name `thriftit_test`.
# Or use a local MongoDB instance for fully isolated testing.
MONGODB_URI_TEST=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/thriftit_test?retryWrites=true&w=majority&appName=Cluster0&tlsAllowInvalidCertificates=true

# Test JWT secret (can be anything — never use production secret here)
JWT_SECRET=test_jwt_secret_for_local_testing_only

# Test port (server doesn't need to run for unit tests, but useful for integration)
PORT=4001

# Disable AI features in tests to avoid hitting Gemini API
# (tests don't need real AI responses)
GEMINI_API_KEY=