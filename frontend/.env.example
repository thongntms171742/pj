# Build Your Christmas — Frontend environment EXAMPLE
# Copy thành `frontend/.env.local` và điền giá trị thật.

# ── API base (REST) ─────────────────────────────────────────
# Local dev:        http://localhost:4000
# Production BE:    https://api.your-domain.com
VITE_API_URL=http://localhost:4000

# ── Socket.io URL ───────────────────────────────────────────
# PHẢI trỏ về BACKEND (không phải Vercel)
# Vì socket.io cần long-lived connection — Vercel serverless không host được
VITE_SOCKET_URL=http://localhost:4000
